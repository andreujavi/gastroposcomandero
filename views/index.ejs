  <!-- Modal Producto -->
  <div class="modal-backdrop" id="productModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="productModalTitle">Nuevo Producto</h3>
        <button class="close-btn" onclick="closeModal('productModal')">×</button>
      </div>
