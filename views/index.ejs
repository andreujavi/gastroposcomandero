            <button class="btn btn-soft" onclick="exportBackup()">💾 Copia SQLite</button>
          </div>

          <div class="data-panel">
            <div class="toolbar">
              <strong>Tickets</strong>
              <input class="search" id="ticketSearch" type="search" placeholder="Buscar ticket..." oninput="renderTickets()" />
            </div>
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th>Nº Ticket</th>
