      </div>
      <div class="modal-footer">
        <button class="btn btn-soft" onclick="closeModal('productModal')">Cancelar</button>
        <button class="btn btn-primary" onclick="saveProduct()">Guardar</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <!-- Script Lógica SQLite y UI -->
  <script>
    let SQL, db;
    let selectedZone = "Interior";
    let selectedCategory = "Todos";
    let selectedPaymentMethod = "Efectivo";

    let currentOrder = {
      id: null,
      type: "barra",
      tableId: null,
      tableName: "Pedido Rápido",
      lines: []
    };

    const defaultProducts = [
      ["Cerveza Barril", "Bebidas", 2.50, "Barra", "🍺"],
      ["Copa de Vino", "Bebidas", 3.20, "Barra", "🍷"],
      ["Agua Mineral", "Bebidas", 1.80, "Barra", "💧"],
      ["Patatas Bravas", "Tapas", 6.50, "Cocina", "🍟"],
      ["Croquetas", "Tapas", 8.00, "Cocina", "🥟"],
      ["Bocadillo Tortilla", "Bocadillos", 5.50, "Cocina", "🥪"],
      ["Café con Leche", "Cafés", 1.60, "Barra", "☕"],
      ["Tarta de Queso", "Postres", 5.00, "Cocina", "🍰"]
    ];

    const defaultTables = [
      ["Interior", "Mesa 1", 4], ["Interior", "Mesa 2", 4], ["Interior", "Mesa 3", 2],
      ["Exterior", "Terraza 1", 4], ["Exterior", "Terraza 2", 6],
      ["Barra", "Barra 1", 1], ["Barra", "Barra 2", 1]
    ];

    function money(v) {
      return Number(v || 0).toLocaleString("es-ES", { style: "currency", currency: "EUR" });
    }

    function sqlRows(query, params = []) {
      const stmt = db.prepare(query);
      stmt.bind(params);
      const rows = [];
      while (stmt.step()) rows.push(stmt.getAsObject());
      stmt.free();
      return rows;
    }

    function sqlValue(query, params = [], fallback = 0) {
      const r = sqlRows(query, params);
      return r.length ? Object.values(r[0])[0] : fallback;
    }

    function persistDatabase() {
      const data = db.export();
      localStorage.setItem("gastropos_sqlite", JSON.stringify(Array.from(data)));
    }

    async function initDatabase() {
      SQL = await initSqlJs({
        locateFile: file => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.3/${file}`
      });

      const saved = localStorage.getItem("gastropos_sqlite");
      db = saved ? new SQL.Database(new Uint8Array(JSON.parse(saved))) : new SQL.Database();

      db.run(`
        CREATE TABLE IF NOT EXISTS tables_restaurant (id INTEGER PRIMARY KEY AUTOINCREMENT, zone TEXT, name TEXT, capacity INTEGER, status TEXT DEFAULT 'libre');
        CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, category TEXT, price REAL, destination TEXT, icon TEXT, available INTEGER DEFAULT 1);
        CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, table_id INTEGER, order_type TEXT, table_name TEXT, status TEXT DEFAULT 'abierto', created_at TEXT);
        CREATE TABLE IF NOT EXISTS order_lines (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id INTEGER, product_id INTEGER, product_name TEXT, price REAL, quantity INTEGER DEFAULT 1, notes TEXT);
        CREATE TABLE IF NOT EXISTS tickets (id INTEGER PRIMARY KEY AUTOINCREMENT, ticket_number TEXT UNIQUE, order_id INTEGER, table_name TEXT, payment_method TEXT, subtotal REAL, iva REAL, total REAL, created_at TEXT);
      `);

      if (sqlValue("SELECT COUNT(*) FROM products") === 0) {
        defaultProducts.forEach(p => db.run("INSERT INTO products (name, category, price, destination, icon) VALUES (?, ?, ?, ?, ?)", p));
      }

      if (sqlValue("SELECT COUNT(*) FROM tables_restaurant") === 0) {
        defaultTables.forEach(t => db.run("INSERT INTO tables_restaurant (zone, name, capacity) VALUES (?, ?, ?)", t));
      }

      persistDatabase();
      renderAll();
    }

    function renderAll() {
      renderDashboard();
      renderTables();
      renderCategories();
      renderProductsGrid();
      renderOrder();
      renderProductsTable();
      renderTickets();
      updateClock();
    }

    function updateClock() {
      const d = new Date();
      document.getElementById("clock").textContent = d.toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });
    }
    setInterval(updateClock, 10000);

    function showView(view) {
      document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
      document.querySelectorAll(".nav-link, .mobile-nav-btn").forEach(b => {
        b.classList.toggle("active", b.dataset.view === view);
      });
      document.getElementById(view).classList.add("active");
    }

    document.querySelectorAll(".nav-link, .mobile-nav-btn").forEach(btn => {
      btn.addEventListener("click", () => showView(btn.dataset.view));
    });

    document.querySelectorAll(".zone-tab").forEach(tab => {
      tab.addEventListener("click", e => {
        selectedZone = e.target.dataset.zone;
        document.querySelectorAll(".zone-tab").forEach(t => t.classList.toggle("active", t === e.target));
        renderTables();
      });
    });

    function togglePosMobileView(mode) {
      const layout = document.getElementById("posLayout");
      const btnProducts = document.getElementById("btnPosProducts");
      const btnOrder = document.getElementById("btnPosOrder");

      if (mode === "order") {
        layout.classList.add("show-order");
        btnOrder.classList.add("active");
        btnProducts.classList.remove("active");
      } else {
        layout.classList.remove("show-order");
        btnProducts.classList.add("active");
        btnOrder.classList.remove("active");
      }
    }

    function renderDashboard() {
      const ventas = sqlValue("SELECT COALESCE(SUM(total),0) FROM tickets");
      const tickets = sqlValue("SELECT COUNT(*) FROM tickets");
      const ocupadas = sqlValue("SELECT COUNT(*) FROM tables_restaurant WHERE status='ocupada'");
      const totalMesas = sqlValue("SELECT COUNT(*) FROM tables_restaurant");
      const pedidos = sqlValue("SELECT COUNT(*) FROM orders WHERE status='abierto'");

      document.getElementById("statVentas").textContent = money(ventas);
      document.getElementById("statTickets").textContent = tickets;
      document.getElementById("statMesas").textContent = `${ocupadas} / ${totalMesas}`;
      document.getElementById("statPedidos").textContent = pedidos;
    }

    function renderTables() {
      const tables = sqlRows("SELECT * FROM tables_restaurant WHERE zone=?", [selectedZone]);
      const grid = document.getElementById("tablesGrid");

      grid.innerHTML = tables.map(t => `
        <button class="table-card" onclick="openTable(${t.id})">
          <span class="status status-${t.status === 'ocupada' ? 'busy' : 'free'}">${t.status}</span>
          <h3>${t.name}</h3>
          <p>${t.capacity} Personas</p>
          <div class="table-total">Abrir Pedido</div>
        </button>
      `).join("");
    }

    function openTable(id) {
      const table = sqlRows("SELECT * FROM tables_restaurant WHERE id=?", [id])[0];
      if (!table) return;

      let order = sqlRows("SELECT * FROM orders WHERE table_id=? AND status='abierto' ORDER BY id DESC LIMIT 1", [id])[0];

      if (!order) {
        const now = new Date().toISOString();
        db.run("INSERT INTO orders (table_id, order_type, table_name, created_at) VALUES (?, 'mesa', ?, ?)", [table.id, table.name, now]);
        db.run("UPDATE tables_restaurant SET status='ocupada' WHERE id=?", [table.id]);
        persistDatabase();
        order = sqlRows("SELECT * FROM orders WHERE table_id=? AND status='abierto' ORDER BY id DESC LIMIT 1", [id])[0];
      }

      currentOrder = { id: order.id, type: "mesa", tableId: table.id, tableName: table.name, lines: loadOrderLines(order.id) };
      showView("pedidos");
      renderOrder();
      showToast(`${table.name} cargada`);
    }

    function startQuickOrder(type) {
      const labels = { barra: "Pedido Barra", para_llevar: "Para Llevar", delivery: "Delivery" };
      const now = new Date().toISOString();
      db.run("INSERT INTO orders (table_id, order_type, table_name, created_at) VALUES (NULL, ?, ?, ?)", [type, labels[type], now]);
      const id = sqlValue("SELECT last_insert_rowid()");

      currentOrder = { id, type, tableId: null, tableName: labels[type], lines: [] };
      persistDatabase();
      showView("pedidos");
      renderOrder();
      showToast(`${labels[type]} iniciado`);
    }

    function loadOrderLines(orderId) {
      return sqlRows("SELECT * FROM order_lines WHERE order_id=?", [orderId]);
    }

    function renderCategories() {
      const cats = ["Todos", ...new Set(sqlRows("SELECT category FROM products").map(r => r.category))];
      document.getElementById("categories").innerHTML = cats.map(c => `
        <button class="category-btn ${selectedCategory === c ? 'active' : ''}" onclick="selectCategory('${c}')">${c}</button>
      `).join("");
    }

    function selectCategory(c) {
      selectedCategory = c;
      renderCategories();
      renderProductsGrid();
    }

    function renderProductsGrid() {
      let q = "SELECT * FROM products WHERE available=1";
      let p = [];
      if (selectedCategory !== "Todos") { q += " AND category=?"; p.push(selectedCategory); }

      const products = sqlRows(q, p);
      document.getElementById("productsGrid").innerHTML = products.map(p => `
        <button class="product-btn" onclick="addProductToOrder(${p.id})">
          <span class="product-icon">${p.icon}</span>
          <span class="product-name">${p.name}</span>
          <span class="product-price">${money(p.price)}</span>
        </button>
      `).join("");
    }

    function addProductToOrder(pId) {
      if (!currentOrder.id) startQuickOrder("barra");
      const product = sqlRows("SELECT * FROM products WHERE id=?", [pId])[0];
      if (!product) return;

      const line = currentOrder.lines.find(l => l.product_id === pId);
      if (line) {
        line.quantity += 1;
        db.run("UPDATE order_lines SET quantity=? WHERE id=?", [line.quantity, line.id]);
      } else {
        db.run("INSERT INTO order_lines (order_id, product_id, product_name, price, quantity) VALUES (?, ?, ?, ?, 1)",
          [currentOrder.id, product.id, product.name, product.price]);
        const lineId = sqlValue("SELECT last_insert_rowid()");
        currentOrder.lines.push({ id: lineId, product_id: product.id, product_name: product.name, price: product.price, quantity: 1 });
      }

      persistDatabase();
      renderOrder();
    }

    function renderOrder() {
      document.getElementById("orderTitle").textContent = currentOrder.tableName;
      document.getElementById("currentOrderInfo").textContent = currentOrder.id ? `Pedido #${currentOrder.id}` : "Sin pedido";

      const container = document.getElementById("orderLines");
      if (!currentOrder.lines.length) {
        container.innerHTML = `<div class="order-empty">No hay productos en la comanda</div>`;
      } else {
        container.innerHTML = currentOrder.lines.map(l => `
          <div class="order-line">
            <div class="order-line-top">
              <span class="order-line-name">${l.product_name}</span>
              <span class="order-line-price">${money(l.price * l.quantity)}</span>
            </div>
            <div class="order-line-controls">
              <button class="qty-btn" onclick="updateQty(${l.id}, -1)">-</button>
              <span class="qty-number">${l.quantity}</span>
              <button class="qty-btn" onclick="updateQty(${l.id}, 1)">+</button>
              <button class="delete-line" onclick="removeLine(${l.id})">×</button>
            </div>
          </div>
        `).join("");
      }

      const subtotal = currentOrder.lines.reduce((s, l) => s + (l.price * l.quantity), 0);
      const iva = subtotal * 0.10;
      const total = subtotal + iva;

      document.getElementById("subtotal").textContent = money(subtotal);
      document.getElementById("iva").textContent = money(iva);
      document.getElementById("total").textContent = money(total);

      // Actualizar contador movil
      const itemCount = currentOrder.lines.reduce((s, l) => s + l.quantity, 0);
      document.getElementById("mobileOrderCount").textContent = itemCount;
    }

    function updateQty(lineId, delta) {
      const line = currentOrder.lines.find(l => l.id === lineId);
      if (!line) return;
      line.quantity += delta;
      if (line.quantity <= 0) return removeLine(lineId);

      db.run("UPDATE order_lines SET quantity=? WHERE id=?", [line.quantity, line.id]);
      persistDatabase();
      renderOrder();
    }

    function removeLine(lineId) {
      db.run("DELETE FROM order_lines WHERE id=?", [lineId]);
      currentOrder.lines = currentOrder.lines.filter(l => l.id !== lineId);
      persistDatabase();
      renderOrder();
    }

    function openPaymentModal() {
      if (!currentOrder.lines.length) return showToast("Añade productos primero");
      const subtotal = currentOrder.lines.reduce((s, l) => s + (l.price * l.quantity), 0);
      const total = subtotal * 1.10;

      document.getElementById("paymentTotal").textContent = money(total);
      document.getElementById("cashReceived").value = total.toFixed(2);
      updateChange();
      document.getElementById("paymentModal").classList.add("show");
    }

    function updateChange() {
      const subtotal = currentOrder.lines.reduce((s, l) => s + (l.price * l.quantity), 0);
      const total = subtotal * 1.10;
      const rec = Number(document.getElementById("cashReceived").value || 0);
      document.getElementById("changeAmount").value = money(Math.max(0, rec - total));
    }

    function completePayment() {
      const subtotal = currentOrder.lines.reduce((s, l) => s + (l.price * l.quantity), 0);
      const total = subtotal * 1.10;
      const iva = subtotal * 0.10;
      const ticketNum = `T-${Date.now().toString().slice(-6)}`;
      const now = new Date().toISOString();

      db.run("INSERT INTO tickets (ticket_number, order_id, table_name, payment_method, subtotal, iva, total, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        [ticketNum, currentOrder.id, currentOrder.tableName, selectedPaymentMethod, subtotal, iva, total, now]);

      db.run("UPDATE orders SET status='cerrado' WHERE id=?", [currentOrder.id]);
      if (currentOrder.tableId) db.run("UPDATE tables_restaurant SET status='libre' WHERE id=?", [currentOrder.tableId]);

      persistDatabase();
      closeModal("paymentModal");
      currentOrder = { id: null, type: "barra", tableId: null, tableName: "Pedido Rápido", lines: [] };

      renderAll();
      showView("tickets");
      showToast(`Ticket ${ticketNum} completado`);
    }

    function renderProductsTable() {
      const search = document.getElementById("productSearch")?.value?.toLowerCase() || "";
      const products = sqlRows("SELECT * FROM products").filter(p => p.name.toLowerCase().includes(search));

      document.getElementById("productsTable").innerHTML = products.map(p => `
        <tr>
          <td><strong>${p.icon} ${p.name}</strong></td>
          <td>${p.category}</td>
          <td><strong>${money(p.price)}</strong></td>
          <td>${p.destination}</td>
          <td><button class="btn btn-soft" onclick="editProduct(${p.id})">Editar</button></td>
        </tr>
      `).join("");
    }

    function renderTickets() {
      const tickets = sqlRows("SELECT * FROM tickets ORDER BY id DESC");
      document.getElementById("ticketsTable").innerHTML = tickets.map(t => `
        <tr>
          <td><strong>${t.ticket_number}</strong></td>
          <td>${new Date(t.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</td>
          <td>${t.table_name}</td>
          <td>${t.payment_method}</td>
          <td><strong>${money(t.total)}</strong></td>
          <td><button class="btn btn-soft" onclick="window.print()">🖨️</button></td>
        </tr>
      `).join("");
    }

    function exportBackup() {
      const data = db.export();
      const blob = new Blob([data], { type: "application/x-sqlite3" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `gastropos_${new Date().toISOString().slice(0,10)}.sqlite`;
      a.click();
    }

    function closeModal(id) { document.getElementById(id).classList.remove("show"); }

    function showToast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg;
      t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2500);
    }

    initDatabase();
  </script>
  <script src="/socket.io/socket.io.js"></script>
<script>
    // 💡 Detecta automáticamente si estás en localhost o en la IP de la red local
    const socket = io(); 
    
    let carrito = [];

    const contenedorTicket = document.querySelector('.ticket-items');
    const elementoTotal = document.querySelector('.ticket-total');
    const btnCobrar = document.querySelector('.btn-cobrar');
    const tarjetasProducto = document.querySelectorAll('.product-card');
    const inputMesa = document.getElementById('input-mesa');

    function actualizarInterfazTicket() {
        if (carrito.length === 0) {
            contenedorTicket.innerHTML = '<em>Selecciona productos para añadirlos al ticket...</em>';
            elementoTotal.innerText = 'Total: 0.00 €';
            return;
        }

        let html = '<ul style="list-style: none; padding: 0; text-align: left;">';
        let total = 0;

        carrito.forEach(item => {
            const subtotal = item.precio * item.cantidad;
            total += subtotal;
            html += `
                <li style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #e5e7eb; padding-bottom: 5px;">
                    <span>${item.cantidad}x ${item.nombre}</span>
                    <span>${subtotal.toFixed(2)} €</span>
                </li>
            `;
        });

        html += '</ul>';
        contenedorTicket.innerHTML = html;
        elementoTotal.innerText = `Total: ${total.toFixed(2)} €`;
    }

    tarjetasProducto.forEach(tarjeta => {
        tarjeta.addEventListener('click', () => {
            const nombre = tarjeta.dataset.nombre;
            const precio = parseFloat(tarjeta.dataset.precio);

            const productoExistente = carrito.find(item => item.nombre === nombre);

            if (productoExistente) {
                productoExistente.cantidad++;
            } else {
                carrito.push({ nombre, precio, cantidad: 1 });
            }

            actualizarInterfazTicket();
        });
    });

    btnCobrar.addEventListener('click', () => {
        if (carrito.length === 0) {
            alert("El ticket está vacío. Selecciona algún producto primero.");
            return;
        }

        const numeroMesa = inputMesa.value;
        if (!numeroMesa) {
            alert("❌ Por favor, introduce el número de mesa.");
            inputMesa.focus();
            return;
        }

        const itemsParaCocina = carrito.map(item => `${item.cantidad}x ${item.nombre}`);

        const pedidoReal = {
            mesa: numeroMesa,
            items: itemsParaCocina,
            estado: "Pendiente"
        };

        // Envía el pedido al servidor por la red
        socket.emit('enviar_pedido', pedidoReal);
        
        carrito = [];
        inputMesa.value = '';
        actualizarInterfazTicket();
        
        const textoOriginal = btnCobrar.innerText;
        btnCobrar.innerText = "¡Enviado a Cocina!";
        btnCobrar.style.backgroundColor = "#059669";
        setTimeout(() => {
            btnCobrar.innerText = textoOriginal;
            btnCobrar.style.backgroundColor = "#10b981";
        }, 1500);
    });
</script>
</body>
</html>
