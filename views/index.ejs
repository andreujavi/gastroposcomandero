        <div style="background: var(--primary-light); padding: 16px; border-radius: var(--radius-md); text-align: center; margin-bottom: 16px;">
          <span style="color: var(--muted); font-size: 12px; font-weight: 700;">TOTAL A COBRAR</span>
          <strong id="paymentTotal" style="display: block; font-size: 32px; color: var(--primary); margin-top: 2px;">0,00 €</strong>
       </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px;">
          <button class="btn btn-soft active" class="pay-method" data-pay="Efectivo" onclick="setPaymentMethod('Efectivo')">💵 Efectivo</button>
          <button class="btn btn-soft" class="pay-method" data-pay="Tarjeta" onclick="setPaymentMethod('Tarjeta')">💳 Tarjeta</button>
